# ---------------------------------------------------------------------------
# PERSONAL FINANCIAL DATA — never commit these.
#
# portfolio.db holds real positions: share counts, average cost, and the NAV
# history built from them. This repository is public. The application creates
# its own database on first run, so nothing here is needed for someone else to
# use it.
# ---------------------------------------------------------------------------
portfolio.db
portfolio.db-wal
portfolio.db-shm
portfolio_backup_*.db
*.db

# Local settings. May contain machine-specific paths; is not needed by anyone
# else, since .env.example documents every option.
.env

# ---------------------------------------------------------------------------
# Build output — regenerable, and roughly 1.3 GB between them.
# Compiled artifacts belong on the Releases page, not in the history: git
# stores every version of every file forever, so committing a 110 MB installer
# once makes the repository 110 MB heavier for everybody, permanently.
# ---------------------------------------------------------------------------
build/
desktop/node_modules/
desktop/dist/

# Python
.venv/
__pycache__/
*.py[cod]

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
