# ---------------------------------------------------------------------------
# 配置文件模板 / Settings template
#
# 用法:把本文件复制为 .env(去掉 .example 后缀),按需修改,然后重启服务。
#   Windows PowerShell :  Copy-Item .env.example .env
#   macOS / Linux      :  cp .env.example .env
#
# 每一项都可以删掉或注释掉 —— 删掉即使用默认值。
# 真实环境变量优先级高于本文件,所以临时覆盖仍然有效:
#   PowerShell :  $env:PORT="9000"; python server.py
#   bash       :  PORT=9000 python3 server.py
#
# 改完必须重启服务才会生效。启动时终端会打印实际生效的配置,
# 也可以访问 http://127.0.0.1:8000/api/status 查看 config 字段。
# ---------------------------------------------------------------------------

# 服务端口。被占用时改这里(如 8001)。
PORT=8000

# 每日自动抓取的【本地】小时,0-23。
# 建议设在你关注的最后一个市场收盘之后。
# 多伦多时区:美股 16:00 收盘,故 18 已足够;若想更保险可设 20。
FETCH_HOUR=18

# 每次抓取回溯的窗口,用于自动补齐停机期间漏掉的交易日。
# 停机可能超过两周的话可以调大,如 30d。
FETCH_LOOKBACK=10d

# 数据库路径。默认在本文件夹下的 portfolio.db。
# 想放到别处(如同步盘)就填绝对路径。
# Windows 反斜杠请写成双写或改用正斜杠:T:/Personal/Trading/portfolio.db
#PORTFOLIO_DB=T:/Personal/Trading/buffet_style_holdings/portfolio.db

# 模型指数的【基准货币】—— 净值以它计价(初始 100亿 / 2亿份 = 每份 50.00)。
# 可选:CHF USD EUR GBP CAD JPY DKK。默认 CHF。
# 注意:指数一旦播种,基准货币就不能中途更改(否则净值序列前后不可比)。
# 确实要改的话:改完本项 -> 重启 -> POST /api/reset_index?confirm=true 重新播种。
# 你的持仓与价格存档不会受影响。
BASE_CCY=CHF

# 设为 1 使用【假数据】测试管道,页面会显示红色 MOCK 警告。
# 正式使用请保持 0 或整行删掉。
MARKETDATA_MOCK=0
