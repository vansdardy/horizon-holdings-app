{
  "name": "horizon-holdings-desktop",
  "productName": "Horizon Holdings",
  "version": "1.10.0",
  "description": "Desktop shell for the Horizon Holdings portfolio NAV service",
  "author": "Horizon Holdings",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.horizonholdings.desktop",
    "productName": "Horizon Holdings",
    "directories": {
      "output": "../build/desktop-dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "vansdardy",
        "repo": "horizon-holdings-app"
      }
    ],
    "extraResources": [
      {
        "from": "../build/backend/horizon-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Horizon-Holdings-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "shortcutName": "Horizon Holdings",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
